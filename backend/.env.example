# ---- Server ----
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database ----
# SQLite file, created automatically on first run. No external DB needed.
DB_PATH=./data/clinic.db

# ---- LLM (Anthropic) ----
# Get a key from https://console.anthropic.com/
# If left blank, the app automatically falls back to a rule-based
# summary generator so nothing ever breaks (see src/services/llm.service.js)
ANTHROPIC_API_KEY=
# Double check the current model name in https://docs.claude.com before deploying
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Email (SMTP) ----
# Leave all four blank during local development/demo: the server will
# automatically create a free Ethereal test inbox on startup and print a
# preview link in the console for every email "sent".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="City Clinic <no-reply@cityclinic.example>"

# ---- Google Calendar (OAuth 2.0) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# (Application type: Web application). Add the redirect URI below to the
# "Authorized redirect URIs" list. See README.md -> "Google Calendar setup".
# If left blank, calendar sync is skipped gracefully and everything else
# keeps working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback
